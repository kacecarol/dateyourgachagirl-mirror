# 复制本文件为 worker.env，填入你自己的密钥。worker.env 不会上传到 GitHub。
# 编辑后保存，下次双击 start_worker.bat 生效。

# —— 反向连接 Render 镜像（默认开启）——
RENDER_TOKEN=你的Render服务WORKER_TOKEN

# —— 连 Cloudflare 原站（可选；留空则只连 Render）——
RELAY_TOKEN=

# —— 以下一般无需改动 ——
RENDER_WS=wss://dateyourgachagirl-mirror.onrender.com/ws
RELAY_URL=https://date-your-gacha-girl.pages.dev
COMFY_URL=http://127.0.0.1:8189
WORKER_ID=local-studio-1
